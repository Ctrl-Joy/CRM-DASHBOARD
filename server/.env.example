# Copy to .env (npm run setup does this automatically if .env is missing).
# The default is a local PostgreSQL that `npm run dev` starts for you (no install
# needed; data lives in server/.pgdata). For a hosted database such as Neon, paste
# its connection string instead, e.g. postgresql://user:pass@host/db?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/nexora"
# Change this in production: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
# Set to 1 when serving over HTTPS so auth cookies are marked Secure.
SECURE_COOKIES=0
# Proxy hops in front of the app (1 on Railway/Render; detected automatically on Railway and Render).
# TRUST_PROXY=1
# One-click "Try the live demo" sign-in, shown only after `npm run seed`. Set to false to hide it.
DEMO_LOGIN=true
