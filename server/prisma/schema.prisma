// Nimbus CRM data model.
//
// Multi-tenant: every row carries orgId, and every query is scoped to the
// signed-in user's organization (see src/lib/scope.ts). Enumerations are plain
// strings validated by the zod schemas in @crm/shared, so adding a value needs
// no migration. Records soft-delete via deletedAt.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                   String   @id @default(cuid())
  name                 String
  currency             String   @default("USD")
  currencies           String   @default("USD") // comma-separated
  fiscalYearStartMonth Int      @default(1)
  leadApiKey           String   @unique
  autoAssignLeads      Boolean  @default(true)
  assignmentMode       String   @default("round_robin") // round_robin | territory
  roundRobinCursor     Int      @default(0)
  rolePermissions      String?  // JSON overrides of DEFAULT_ROLE_PERMISSIONS
  ticketCounter        Int      @default(0)
  quoteCounter         Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  users User[]
  teams Team[]
}

model User {
  id           String    @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("rep") // rep | manager | admin
  teamId       String?
  team         Team?     @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  avatarUrl    String?
  quota        Float     @default(0) // monthly revenue quota
  territory    String?
  active       Boolean   @default(true)
  tokenVersion Int       @default(0) // bump to revoke all sessions
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  managedTeams   Team[]          @relation("TeamManager")
  companies      Company[]
  contacts       Contact[]
  leads          Lead[]
  deals          Deal[]
  activities     Activity[]
  tasks          Task[]
  tickets        Ticket[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  stageChanges   DealStageHistory[]
  attachments    Attachment[]

  @@index([orgId])
}

model Team {
  id        String   @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  managerId String?
  manager   User?    @relation("TeamManager", fields: [managerId], references: [id], onDelete: SetNull)
  members   User[]   @relation("TeamMembers")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
}

model Tag {
  id        String    @id @default(cuid())
  orgId     String
  name      String
  color     String    @default("#64748b")
  contacts  Contact[]
  companies Company[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([orgId, name])
}

model Company {
  id           String    @id @default(cuid())
  orgId        String
  name         String
  domain       String?
  industry     String?
  size         String?
  address      String?
  phone        String?
  territory    String?
  ownerId      String?
  owner        User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  customFields String    @default("{}")
  tags         Tag[]
  contacts     Contact[]
  deals        Deal[]
  activities   Activity[]
  tasks        Task[]
  tickets      Ticket[]
  attachments  Attachment[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([orgId, deletedAt])
  @@index([ownerId])
}

model Contact {
  id              String    @id @default(cuid())
  orgId           String
  firstName       String
  lastName        String?
  email           String?
  phone           String?
  title           String?
  companyId       String?
  company         Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  ownerId         String?
  owner           User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  source          String?
  status          String    @default("active")
  lifecycleStage  String    @default("lead")
  lastContactedAt DateTime?
  customFields    String    @default("{}")
  tags            Tag[]
  deals           Deal[]
  activities      Activity[]
  tasks           Task[]
  tickets         Ticket[]
  attachments     Attachment[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([orgId, deletedAt])
  @@index([ownerId])
  @@index([email])
}

model Lead {
  id                 String    @id @default(cuid())
  orgId              String
  firstName          String
  lastName           String?
  email              String?
  phone              String?
  companyName        String?
  title              String?
  companySize        String?
  source             String    @default("website")
  status             String    @default("new")
  score              Int       @default(0)
  scoreBreakdown     String    @default("[]") // JSON [{label, points}]
  ownerId            String?
  owner              User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  assignedAt         DateTime?
  firstResponseAt    DateTime?
  territory          String?
  campaignId         String?
  campaign           Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  message            String?
  convertedAt        DateTime?
  convertedContactId String?
  convertedDealId    String?
  customFields       String    @default("{}")
  activities         Activity[]
  tasks              Task[]
  attachments        Attachment[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  @@index([orgId, deletedAt, status])
  @@index([ownerId])
}

model Pipeline {
  id        String    @id @default(cuid())
  orgId     String
  name      String
  isDefault Boolean   @default(false)
  stages    Stage[]
  deals     Deal[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([orgId])
}

model Stage {
  id          String   @id @default(cuid())
  pipelineId  String
  pipeline    Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name        String
  order       Int
  probability Int      @default(10) // win probability %
  deals       Deal[]
  historyFrom DealStageHistory[] @relation("FromStage")
  historyTo   DealStageHistory[] @relation("ToStage")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([pipelineId, order])
}

model Deal {
  id                String    @id @default(cuid())
  orgId             String
  title             String
  value             Float     @default(0)
  currency          String    @default("USD")
  pipelineId        String
  pipeline          Pipeline  @relation(fields: [pipelineId], references: [id])
  stageId           String
  stage             Stage     @relation(fields: [stageId], references: [id])
  contactId         String?
  contact           Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  companyId         String?
  company           Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  ownerId           String?
  owner             User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  expectedCloseDate DateTime?
  probability       Int?      // null = use the stage's probability
  status            String    @default("open") // open | won | lost
  lostReason        String?
  closedAt          DateTime?
  stageChangedAt    DateTime  @default(now())
  lastActivityAt    DateTime?
  campaignId        String?
  campaign          Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  customFields      String    @default("{}")
  stageHistory      DealStageHistory[]
  activities        Activity[]
  tasks             Task[]
  quotes            Quote[]
  attachments       Attachment[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  @@index([orgId, deletedAt, status])
  @@index([pipelineId, stageId])
  @@index([ownerId])
}

model DealStageHistory {
  id          String   @id @default(cuid())
  dealId      String
  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  fromStageId String?
  fromStage   Stage?   @relation("FromStage", fields: [fromStageId], references: [id], onDelete: SetNull)
  toStageId   String
  toStage     Stage    @relation("ToStage", fields: [toStageId], references: [id], onDelete: Cascade)
  changedById String?
  changedBy   User?    @relation(fields: [changedById], references: [id], onDelete: SetNull)
  changedAt   DateTime @default(now())

  @@index([dealId])
}

// Calls, emails, meetings and notes. "Note" in the product is an activity of
// type "note", so the timeline has a single source.
model Activity {
  id          String    @id @default(cuid())
  orgId       String
  type        String    // call | email | meeting | note | task
  subject     String
  body        String?
  contactId   String?
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  companyId   String?
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  dealId      String?
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  leadId      String?
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  ticketId    String?
  ticket      Ticket?   @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id])
  dueAt       DateTime?
  completed   Boolean   @default(true)
  completedAt DateTime?
  outcome     String?
  durationMin Int?
  emailTo     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([orgId, deletedAt, createdAt])
  @@index([contactId])
  @@index([dealId])
  @@index([companyId])
}

model Task {
  id          String    @id @default(cuid())
  orgId       String
  title       String
  description String?
  dueDate     DateTime?
  priority    String    @default("medium")
  status      String    @default("todo") // todo | in_progress | done
  assigneeId  String?
  assignee    User?     @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById String?
  reminderAt  DateTime?
  reminded    Boolean   @default(false)
  completedAt DateTime?
  contactId   String?
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  companyId   String?
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  dealId      String?
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  leadId      String?
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  ticketId    String?
  ticket      Ticket?   @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([orgId, deletedAt, status])
  @@index([assigneeId, dueDate])
}

model Product {
  id          String    @id @default(cuid())
  orgId       String
  name        String
  sku         String?
  price       Float     @default(0)
  description String?
  active      Boolean   @default(true)
  lineItems   QuoteLineItem[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([orgId, deletedAt])
}

model Quote {
  id         String    @id @default(cuid())
  orgId      String
  number     String
  dealId     String
  deal       Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  status     String    @default("draft")
  taxRate    Float     @default(0)
  discount   Float     @default(0)
  subtotal   Float     @default(0)
  tax        Float     @default(0)
  total      Float     @default(0)
  currency   String    @default("USD")
  validUntil DateTime?
  notes      String?
  lineItems  QuoteLineItem[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([orgId, dealId])
}

model QuoteLineItem {
  id          String   @id @default(cuid())
  quoteId     String
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name        String
  quantity    Float
  unitPrice   Float
  discountPct Float    @default(0)
  total       Float
  position    Int      @default(0)
}

model Ticket {
  id              String    @id @default(cuid())
  orgId           String
  number          Int
  subject         String
  description     String?
  contactId       String?
  contact         Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  companyId       String?
  company         Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  priority        String    @default("normal")
  status          String    @default("open")
  channel         String    @default("email")
  assigneeId      String?
  assignee        User?     @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  slaDueAt        DateTime
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  customFields    String    @default("{}")
  activities      Activity[]
  tasks           Task[]
  attachments     Attachment[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@unique([orgId, number])
  @@index([orgId, deletedAt, status])
}

model Campaign {
  id          String    @id @default(cuid())
  orgId       String
  name        String
  channel     String
  status      String    @default("planned")
  startDate   DateTime?
  endDate     DateTime?
  budget      Float     @default(0)
  description String?
  leads       Lead[]
  deals       Deal[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([orgId, deletedAt])
}

model Attachment {
  id           String   @id @default(cuid())
  orgId        String
  fileName     String
  mimeType     String
  size         Int
  storageKey   String   // file name under server/uploads
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  contactId    String?
  contact      Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dealId       String?
  deal         Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  leadId       String?
  lead         Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  ticketId     String?
  ticket       Ticket?  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([orgId])
}

model AuditLog {
  id         String   @id @default(cuid())
  orgId      String
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   // create | update | delete | restore | login | ...
  entityType String
  entityId   String
  changes    String?  // JSON
  ip         String?
  createdAt  DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([entityType, entityId])
}

model Notification {
  id        String    @id @default(cuid())
  orgId     String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model CustomField {
  id         String   @id @default(cuid())
  orgId      String
  entityType String
  key        String
  label      String
  type       String   // text | number | date | select | checkbox
  options    String   @default("[]") // JSON string[]
  required   Boolean  @default(false)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([orgId, entityType, key])
}

model SavedView {
  id         String   @id @default(cuid())
  orgId      String
  userId     String
  entityType String
  name       String
  filters    String   @default("{}") // JSON of list query params
  shared     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([orgId, entityType])
}

model Workflow {
  id         String    @id @default(cuid())
  orgId      String
  name       String
  trigger    String
  active     Boolean   @default(true)
  conditions String    @default("[]") // JSON [{field, operator, value}]
  actions    String    @default("[]") // JSON [{type, params}]
  runCount   Int       @default(0)
  lastRunAt  DateTime?
  createdById String?
  runs       WorkflowRun[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([orgId, trigger])
}

model WorkflowRun {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  entityId   String
  status     String   // success | skipped | failed
  message    String?
  createdAt  DateTime @default(now())

  @@index([workflowId, createdAt])
}

model EmailTemplate {
  id        String    @id @default(cuid())
  orgId     String
  ownerId   String?
  name      String
  subject   String
  body      String
  shared    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([orgId])
}

model Report {
  id         String    @id @default(cuid())
  orgId      String
  ownerId    String
  name       String
  config     String    // JSON ReportConfig
  schedule   String    @default("none")
  recipients String?
  lastSentAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([orgId])
}
